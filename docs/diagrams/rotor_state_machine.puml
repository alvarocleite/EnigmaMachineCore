@startuml Enigma_Rotor_State_Machine

skinparam monochrome true
skinparam state {
    BackgroundColor White
    BorderColor Black
}

title Rotor State Machine (Stepping Logic)

[*] --> Idle

state Idle {
    note "Waiting for Input Signal" as N1
}

state "Check Position" as CheckPos {
    note "Check notch state BEFORE stepping\natNotch[] precomputed\nLeftmost rotor excluded" as N2
}

state "Engage Notch" as Notch {
    note "Carry: atNotch[i-1]\nDouble-step: atNotch[i] AND not leftmost" as N3
}

state "Rotate" as Rotate {
    note "Rotate rotor\nIncrement position (mod TRANSFORMER_SIZE)" as N4
}

Idle --> CheckPos : Input Signal (Before Encrypting)

CheckPos --> Rotate : Rightmost rotor\n(always steps)
CheckPos --> Notch : Carry or Double-step condition met

Notch --> Rotate : Trigger rotation
Rotate --> Idle : All rotors updated\nObservers notified

@enduml
