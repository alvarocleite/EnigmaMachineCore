@startuml Enigma_Encryption_Sequence_Diagram

skinparam monochrome true
skinparam responseMessageBelowArrow true

actor User
participant "EnigmaMachine" as EM
participant "RotorBox" as RB
participant "PlugBoard" as PB
participant "Rotor (0)" as R0
participant "Rotor (1)" as R1
participant "Rotor (2)" as R2
participant "Reflector" as REF
participant "IEnigmaObserver" as OBS

User -> EM: keyTransform(inputChar: AlphabetIndex)
activate EM

    note right of EM: 1. Electrical Signal Path (Plugboard Entry)
    EM -> PB: swap(inputChar)
    activate PB
    PB --> EM: swappedChar: AlphabetIndex
    deactivate PB

    note right of EM: 2. RotorBox Processing
    EM -> RB: keyTransform(swappedChar)
    activate RB

        note right of RB: 2.1 Mechanical Step (Before Encrypting)
        RB -> RB: updateRotors()
        activate RB
            RB -> R0: rotate()
            alt notch hit
                RB -> R1: rotate()
                alt notch hit
                    RB -> R2: rotate()
                end
            end

            loop for each observer
                RB -> EM: onRotorStepped(rotorIndex, pos: AlphabetIndex)
                activate EM
                    EM -> OBS: onRotorStepped(rotorIndex, pos)
                deactivate EM
            end
        deactivate RB

        note right of RB: 2.2 Forward Pass (0 -> 1 -> 2)
        RB -> R0: transformForward(char)
        R0 --> RB: c1: AlphabetIndex
        RB -> R1: transformForward(c1)
        R1 --> RB: c2: AlphabetIndex
        RB -> R2: transformForward(c2)
        R2 --> RB: c3: AlphabetIndex

        note right of RB: 2.3 Reflection
        RB -> REF: transformForward(c3)
        REF --> RB: c4: AlphabetIndex

        note right of RB: 2.4 Reverse Pass (2 -> 1 -> 0)
        RB -> R2: transformReverse(c4)
        R2 --> RB: c5: AlphabetIndex
        RB -> R1: transformReverse(c5)
        R1 --> RB: c6: AlphabetIndex
        RB -> R0: transformReverse(c6)
        R0 --> RB: c7: AlphabetIndex

    RB --> EM: outputChar: AlphabetIndex
    deactivate RB

    note right of EM: 3. Electrical Signal Path (Plugboard Exit)
    EM -> PB: swap(outputChar)
    activate PB
    PB --> EM: finalChar: AlphabetIndex
    deactivate PB

    note right of EM: 4. Notification
    loop for each observer
        EM -> OBS: onCharEncrypted(inputChar, finalChar)
    end

EM --> User: finalChar: AlphabetIndex
deactivate EM


@enduml
