@startuml EnigmaMachineCore_Class_Diagram

' Styling
skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam linetype ortho

' Enums and Structs
enum TransformerType {
    Undefined
    Rotor
    Reflector
}

class PlugBoardPair <<struct>> {
    + int sourcePortIndex
    + int destinationPortIndex
}

class RotorConfig <<struct>> {
    + int notchPosition
    + std::vector<int> wiring
}

class ReflectorConfig <<struct>> {
    + std::vector<int> wiring
}

' Interfaces
interface IAssetProvider {
    + {abstract} loadAsset(assetName: std::string_view) : std::string
}

interface IEnigmaObserver {
    + {abstract} onRotorStepped(rotorIndex: int, position: int) : void
    + {abstract} onCharEncrypted(input: char, output: char) : void
}

' Classes
class FileAssetProvider {
    + loadAsset(assetName: std::string_view) : std::string
}

class EnigmaMachineConfig <<struct>> {
    + int rotorCount
    + std::vector<int> rotorPositions
    + std::vector<RotorConfig> rotors
    + ReflectorConfig reflector
    + std::array<PlugBoardPair, PLUGBOARD_MAX_PAIRS> plugBoardPairs
    + EnigmaMachineConfig()
}

class EnigmaConfigLoader {
    + {static} load(provider: IAssetProvider, fileName: std::string_view, assetPath: std::string_view) : EnigmaMachineConfig
    + {static} loadRotor(provider: IAssetProvider, fileName: std::string_view) : RotorConfig
    + {static} loadReflector(provider: IAssetProvider, fileName: std::string_view) : ReflectorConfig
}

class EnigmaMachine {
    - rotorBox : std::unique_ptr<RotorBox>
    - plugBoard : std::unique_ptr<PlugBoard>
    - observers : std::vector<IEnigmaObserver*>
    # EnigmaMachine(config: EnigmaMachineConfig)
    + EnigmaMachine()
    + EnigmaMachine(fileName: std::string_view, assetPath: std::string_view)
    + EnigmaMachine(provider: IAssetProvider, fileName: std::string_view, assetPath: std::string_view)
    + ~EnigmaMachine()
    + keyTransform(input: int) : int
    + registerObserver(observer: IEnigmaObserver*) : void
    + removeObserver(observer: IEnigmaObserver*) : void
    + onRotorStepped(rotorIndex: int, position: int) : void
    + onCharEncrypted(input: char, output: char) : void
}

class PlugBoard {
    - mapping : std::array<int, TRANSFORMER_SIZE>
    + PlugBoard()
    + PlugBoard(pairs: std::array<PlugBoardPair, PLUGBOARD_MAX_PAIRS>)
    + ~PlugBoard()
    + swap(key: int) : int const
}

class RotorBox {
    - rotorCount : int
    - rotorPositions : std::vector<int>
    - transformers : std::vector<std::unique_ptr<Transformer>>
    - observers : std::vector<IEnigmaObserver*>
    - initTransformers(rotors: std::vector<RotorConfig>, reflector: ReflectorConfig) : void
    - updateRotors() : void
    + RotorBox()
    + RotorBox(rotorPositions: std::vector<int>, rotors: std::vector<RotorConfig>, reflector: ReflectorConfig)
    + ~RotorBox()
    + printTransformers() : void
    + keyTransform(input: int) : int
    + registerObserver(observer: IEnigmaObserver*) : void
    + removeObserver(observer: IEnigmaObserver*) : void
}

abstract class Transformer {
    - lookupTable : std::array<std::array<int, TRANSFORMER_SIZE>, 2>
    # type : TransformerType
    # setTransformValue(row: int, col: int, value: int) : void
    # getTransformValue(row: int, col: int) : int
    # fillTransformRow(row: int, value: int) : void
    # getTransformRow(row: int) : const std::array<int, TRANSFORMER_SIZE>&
    + Transformer()
    + {abstract} ~Transformer()
    + {abstract} transform(position: int, reverse: bool) : int
    + {abstract} transformForward(position: int) : int
    + {abstract} transformReverse(position: int) : int
    + {abstract} rotate() : int
    + {abstract} setPosition(position: int) : void
    + getPosition() : int
    + sizeOfLookupTable() : int
    + getType() : TransformerType
}

class Rotor {
    - notchPosition : int
    - rotationCount : int
    - initReverseLookupTable() : void
    + isNotchPosition(position: int) : bool
    + Rotor(config: RotorConfig)
    + ~Rotor()
    + transform(position: int, reverse: bool) : int
    + transformForward(position: int) : int
    + transformReverse(position: int) : int
    + rotate() : int
    + setPosition(position: int) : void
    + getPosition() : int
}

class Reflector {
    + Reflector(config: ReflectorConfig)
    + ~Reflector()
    + transform(position: int, reverse: bool) : int
    + transformForward(position: int) : int
    + transformReverse(position: int) : int
    + rotate() : int
}

' Relationships
IAssetProvider <|.. FileAssetProvider : implements
IEnigmaObserver <|.. EnigmaMachine : implements

EnigmaConfigLoader ..> IAssetProvider : uses
EnigmaConfigLoader ..> EnigmaMachineConfig : creates
EnigmaConfigLoader ..> RotorConfig : creates
EnigmaConfigLoader ..> ReflectorConfig : creates

EnigmaMachineConfig *-- RotorConfig
EnigmaMachineConfig *-- ReflectorConfig
EnigmaMachineConfig *-- PlugBoardPair

EnigmaMachine ..> EnigmaMachineConfig : uses
EnigmaMachine ..> EnigmaConfigLoader : uses
EnigmaMachine ..> IAssetProvider : uses
EnigmaMachine *-- RotorBox
EnigmaMachine *-- PlugBoard
EnigmaMachine o-- IEnigmaObserver : notifies

PlugBoard ..> PlugBoardPair

RotorBox o-- Transformer
RotorBox ..> RotorConfig
RotorBox ..> ReflectorConfig
RotorBox o-- IEnigmaObserver : notifies

Transformer <|-- Rotor
Transformer <|-- Reflector
Transformer ..> TransformerType


@enduml
