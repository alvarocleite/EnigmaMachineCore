# Doxyfile 1.9.1

# Project related configuration options
PROJECT_NAME           = "EnigmaMachineCore"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "A modular Enigma Machine simulation in C++20"
OUTPUT_DIRECTORY       = docs/doxygen-gen-files
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO
OUTPUT_LANGUAGE        = English
QUIET                  = YES

# Build related configuration options
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PRIV_VIRTUAL   = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
CASE_SENSE_NAMES       = YES
HIDE_SCOPE_NAMES       = NO
SHOW_INCLUDE_FILES     = YES
SORT_MEMBERS_CTORS_1ST = YES
GENERATE_TODOLIST      = YES
GENERATE_TESTLIST      = YES
GENERATE_BUGLIST       = YES
GENERATE_DEPRECATEDLIST= YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES

# Input files configuration
INPUT                  = README.md \
                         CONTRIBUTING.md \
                         roadmap.md \
                         ./docs \
                         ./EnigmaMachine \
                         ./RotorBox \
                         ./PlugBoard \
                         ./config \
                         ./app/main.cpp
RECURSIVE              = YES
EXCLUDE                = build/ external/ .git/
EXCLUDE_PATTERNS       = */.git/* */build/* */external/*
USE_MDFILE_AS_MAINPAGE = README.md
IMAGE_PATH             = docs/diagrams

# Source browsing
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
VERBATIM_HEADERS       = YES

# HTML configuration
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80
HTML_DYNAMIC_SECTIONS  = YES
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO

# LaTeX configuration
GENERATE_LATEX         = NO

# XML configuration (Required for Sphinx/Breathe)
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES

# Preprocessor
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = ./EnigmaMachine/include \
                         ./RotorBox/include \
                         ./PlugBoard/include \
                         ./config
SKIP_FUNCTION_MACROS   = YES

# Graphviz / Dot
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES

# PlantUML
PLANTUML_JAR_PATH      = @PLANTUML_PATH@
PLANTUML_INCLUDE_PATH  = @CMAKE_CURRENT_SOURCE_DIR@/docs/diagrams
